class Solution {
    public boolean isHappy(int n) {
        int sum=0;

        while(n>0){
          sum += (n % 10) * (n % 10);
          n=n/10;
        }
        
        if(sum==1){
            return true;
        }

        if(sum==4){ // 4 enters into an infinite cycle
            return false;
        }

       return isHappy(sum);
        
    }
}
